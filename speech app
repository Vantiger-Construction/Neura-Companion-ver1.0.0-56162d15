# Function to check the user's progress
def check_progress(username):
    c.execute("SELECT * FROM progress WHERE username = ?", (username,))
    rows = c.fetchall()

    for row in rows:
        print(f"Lesson: {row[2]}, Score: {row[3]}")

# Function to provide feedback based on the user's progress
def provide_feedback(username):
    c.execute("SELECT AVG(score) FROM progress WHERE username = ?", (username,))
    avg_score = c.fetchone()[0]

    if avg_score > 0.8:
        print("Great job! You're ready for more difficult lessons.")
    elif avg_score > 0.6:
        print("Good job, but there's room for improvement.")
    else:
        print("Keep practicing! You'll get there.")

