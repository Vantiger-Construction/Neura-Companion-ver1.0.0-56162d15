from googletrans import Translator
import speech_recognition as sr
from gtts import gTTS
import sqlite3
import os
from nltk.sentiment import SentimentIntensityAnalyzer

# Initialize the translator and recognizer
translator = Translator()
recognizer = sr.Recognizer()
sia = SentimentIntensityAnalyzer()

# Connect to the database
conn = sqlite3.connect('language_learning.db')
c = conn.cursor()

# Create table if it doesn't exist
c.execute('''CREATE TABLE IF NOT EXISTS progress
             (username TEXT, language TEXT, lesson TEXT, score INTEGER)''')

# Set the language to learn
language_to_learn = 'es'  # Spanish

# Common phrases in different languages
common_phrases = {
    'es': ['¿Cómo estás?', 'Buenos días', 'Buenas noches', 'Gracias', 'Lo siento'],
    'fr': ['Comment ça va?', 'Bonjour', 'Bonne nuit', 'Merci', 'Je suis désolé'],
    'de': ['Wie geht es dir?', 'Guten Morgen', 'Gute Nacht', 'Danke', 'Es tut mir leid'],
    # Add more languages here
}

# Function to start a learning session
def start_session(username, language_to_learn):
    # Recognize speech
    with sr.Microphone() as source:
        print("Speak a sentence in English.")
        audio = recognizer.listen(source)
        text = recognizer.recognize_google(audio)

    # Translate the text
    translation = translator.translate(text, dest=language_to_learn)

    # Use Text-to-Speech to provide pronunciation example
    tts = gTTS(text=translation.text, lang=language_to_learn)
    tts.save("example.mp3")
    os.system("mpg321 example.mp3")

    # Perform sentiment analysis on the original text
    sentiment = sia.polarity_scores(text)

    # Display the original and translated text, and the sentiment
    print(f"You said: {text}")
    print(f"In {language_to_learn}, you would say: {translation.text}")
    print(f"The sentiment of your text is: {sentiment}")

    # Update the user's progress in the database
    c.execute("INSERT INTO progress VALUES (?, ?, ?, ?)",
              (username, language_to_learn, text, 1))
    conn.commit()

    # If the text is a common phrase, provide additional information
    if text in common_phrases[language_to_learn]:
        print(f"'{text}' is a common phrase in {language_to_learn}.")

# Close the database connection
conn.close()


